{
  "name": "QWERTY Corporate Style",
  "source": "https://qwerty.software/",
  "colors": {
    "brandOrange": "#FF7900",
    "ink": "#000000",
    "surfaceDark": "#161616",
    "surfaceRaised": "#232323",
    "strokeDark": "#383838",
    "white": "#FFFFFF",
    "textMuted": "#CECECE",
    "warmCanvas": "#F2F1EB",
    "inkSoft": "#1B1B1B",
    "strokeLight": "#D8D6CF"
  },
  "themes": {
    "dark": {
      "canvas": "#000000",
      "surface": "#161616",
      "surfaceRaised": "#232323",
      "text": "#FFFFFF",
      "textSecondary": "#CECECE",
      "stroke": "#383838",
      "accent": "#FF7900"
    },
    "light": {
      "canvas": "#F2F1EB",
      "surface": "#FFFFFF",
      "surfaceMuted": "#E9E7E0",
      "text": "#1B1B1B",
      "textSecondary": "#686868",
      "stroke": "#D8D6CF",
      "accent": "#FF7900",
      "brandPlate": "#000000"
    }
  },
  "typography": {
    "family": "Inter Tight",
    "fallback": ["Inter", "Arial", "sans-serif"],
    "weights": [400, 500, 700]
  },
  "spacing": [8, 16, 24, 32, 48, 64],
  "radius": {
    "small": 4,
    "card": 16,
    "panel": 24
  },
  "grid": {
    "columns": 12,
    "maxWidth": 1280
  }
}
